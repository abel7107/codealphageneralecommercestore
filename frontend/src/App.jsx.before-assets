              className="hidden rounded-full p-2.5 transition hover:bg-gray-100 sm:block"
              aria-label="Account"
            >
              <UserRound size={21} />
            </a>
          </div>
        </div>

        {menuOpen && (
          <nav className="flex flex-col gap-4 border-t border-gray-100 px-6 py-5 text-sm lg:hidden">
